# ==============================================================================
# Traffic E-Challan — Global Environment Configuration Template
# ==============================================================================

# --- PostgreSQL / Supabase Database Connection ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/traffic_challan

# Direct connection parameters (for connection diagnostic tests)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_db_password
DB_SSLMODE=require

# --- Security & JWT Authentication ---
JWT_SECRET=generate-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Microservice URLs ---
ML_SERVICE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173

# --- Email Notifications (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_NAME="Maharashtra Traffic E-Challan"

# --- Payments (Razorpay Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# --- Storage Settings ---
EVIDENCE_STORAGE_PATH=./backend/storage/evidence
RECEIPT_STORAGE_PATH=./backend/storage/receipts

# --- Open-LPR Integration (faisalthaheem/open-lpr) ---
OPEN_LPR_ENABLED=true
OPEN_LPR_MODE=service                       # "service" (Open-LPR container) or "vlm" (Direct Vision LLM)
OPEN_LPR_API_URL=http://localhost:8002/api/v1/ocr/  # Docker service is on port 8002, or http://open-lpr:8000/api/v1/ocr/
OPEN_LPR_VLM_BASE_URL=                      # e.g., http://localhost:11434/v1 for Ollama
OPEN_LPR_VLM_API_KEY=                       # Optional API key for remote VLM
OPEN_LPR_VLM_MODEL=qwen2-vl-7b-instruct     # Model name for VLM mode
OPEN_LPR_TIMEOUT=12.0
OPEN_LPR_FALLBACK_TO_EASYOCR=true

# --- Runtime Environment ---
ENV=development
