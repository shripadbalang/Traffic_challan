# --- Database (PostgreSQL connection string) ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/traffic_challan

# --- Auth ---
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- ML Inference Microservice ---
ML_SERVICE_URL=http://localhost:8001

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Maharashtra Traffic E-Challan

# --- Payments (Razorpay TEST mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Storage ---
EVIDENCE_STORAGE_PATH=./storage/evidence
RECEIPT_STORAGE_PATH=./storage/receipts

# --- App ---
FRONTEND_URL=http://localhost:5173
ENV=development
