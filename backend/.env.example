# --- Database (Supabase / PostgreSQL connection string) ---
# For Supabase Pooler (Transaction Mode, Port 6543):
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/traffic_challan

# Direct connection parameters (for connection diagnostic tests & pooler fallback)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_password
DB_SSLMODE=require
SUPABASE_URL=https://your_project_ref.supabase.co

# --- Auth ---
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- ML Inference Microservice ---
ML_SERVICE_URL=http://localhost:8001

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Maharashtra Traffic E-Challan

# --- Real SMS Delivery (Fast2SMS for India or Twilio for Global) ---
# Leave empty for simulated terminal logging in development
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments (Razorpay TEST mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Storage ---
EVIDENCE_STORAGE_PATH=./storage/evidence
RECEIPT_STORAGE_PATH=./storage/receipts

# --- App ---
FRONTEND_URL=http://localhost:5173
ENV=development
